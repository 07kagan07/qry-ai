# Supabase proje ayarları (Dashboard -> Settings -> API Keys / Data API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# OPSİYONEL — QR kodlara gömülecek adres.
# Boş bırakılırsa uygulamanın açıldığı adres otomatik kullanılır; canlıda bu
# genellikle yeterlidir. Yalnızca birden fazla alan adınız varsa veya QR'ların
# her koşulda tek bir sabit adresi göstermesini istiyorsanız doldurun.
# VITE_PUBLIC_SITE_URL=https://menu.siteniz.com

# NOT: GEMINI_API_KEY frontend'e KONMAZ. Edge Function secret olarak eklenir:
#   supabase secrets set GEMINI_API_KEY=AIza...
# Ücretsiz anahtar: https://aistudio.google.com/apikey
